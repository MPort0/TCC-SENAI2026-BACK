// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model user {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String
  foto        String?
  devolutivas devolutiva[]
  curriculos  curriculo[]
}

model devolutiva {
  id                      Int      @id @default(autoincrement())
  userId                  Int
  cargo                   String
  tecnologia              String
  dificuldade             String
  nota                    Float
  resumo                  String
  fundamentaisNivel       String
  fundamentaisPorcentagem Int
  praticaNivel            String
  praticaPorcentagem      Int
  pontosFortes            String // JSON string
  principaisErros         String // JSON string
  sugestoesEstudo         String // JSON string
  criadoEm                DateTime @default(now())

  user user @relation(fields: [userId], references: [id])
}

model curriculo {
  id          Int      @id @default(autoincrement())
  userId      Int
  nome        String
  cargo       String
  contato     String
  resumo      String
  experiencia String
  formacao    String
  habilidades String // JSON string
  criadoEm    DateTime @default(now())

  user user @relation(fields: [userId], references: [id])
}
